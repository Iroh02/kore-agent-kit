# Copy to .env and fill in. Nothing here is fatal by absence:
# a missing key degrades that one capability and the app still runs.

# --- Claude: extraction + business-card vision ---
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5

# --- Microsoft Teams bot (Azure Bot resource) ---
# Blank = channel disabled, the rest of the app still starts.
MS_APP_ID=
MS_APP_PASSWORD=
MS_TENANT_ID=

# --- Speech to text for voice notes ---
# DECISIONS.md D14. Blank key = canned transcript, clearly labelled.
STT_PROVIDER=deepgram-nova-3
STT_API_KEY=

# --- App ---
PORT=8000
DB_PATH=kore.db
MIN_CONFIDENCE=0.6
SCHEDULER_SECONDS=30
